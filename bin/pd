#!/usr/bin/env python3
"""pd - thin wrapper around the Proton Drive CLI.

Proton is the source of truth: make changes here and the NAS mirror follows on
its next run. Paths without a leading "/" are assumed to be under /my-files.
"""
import os
import re
import subprocess
import sys

CLI = os.path.expanduser("~/.local/bin/proton-drive")


def local_arg(path):
    """The CLI glob-expands local paths containing * ? [ or {, so a real folder
    like "Album [FLAC]" matches nothing and the command fails with "No paths
    matched". Escape the specials, but only for paths that exist, so a quoted
    pattern like '*.mp4' still works. (Same rule as nas/pd_repl.py.)"""
    if re.search(r"[*?\[{]", path) and os.path.exists(path):
        return re.sub(r"([*?\[\]{}\\])", r"\\\1", path)
    return path
ROOT = "/my-files"

USAGE = """pd - manage Proton Drive (source of truth; the NAS mirror follows)

  pd ls [path]                 list a folder              (default /my-files)
  pd info <path>               full metadata incl. sha1 and size
  pd find <text>               match names in a folder     (pd find x [path])

  pd add <local>... [remote]   upload, then verify and repair
                               no thumbnails by default (--thumbs to generate
                                 them; they make TIFF and odd files fail)
                               overwrites Proton copies that DIFFER from local;
                               files that exist only in Proton are left alone
                               --no-verify skips the post-upload check
  pd mkdir <parent> <name>     create a folder
  pd get <path>... [localdir]  download; localdir defaults to .

  pd mv <src>... <destdir>     move   (server-side, instant, no re-upload)
  pd cp <src>... <destdir>     copy   (server-side)
  pd rn <path> <newname>       rename

  pd rm <path>...              move to Proton trash (recoverable)
  pd restore <path>...         restore from Proton trash
  pd purge <path>...           delete permanently (asks first)

  pd verify <local> [remote]   check an upload arrived intact (sha1 per file)
  pd verify --deep <local> [remote]   also download each file and re-hash it
  pd verify --fix <local> [remote]    re-upload anything missing or corrupt

  pd prune-thumbs [path]       strip existing thumbnails (--dry-run, --yes)

  pd share <path>              sharing status
  pd raw <args>...             pass straight through to proton-drive

A leading / is optional. Escape a literal / inside a name as \\/ .
"""


def abs_remote(p):
    # "/" means the sections root (/my-files, /shared-with-me, ...), which is
    # not a real folder -- you cannot create or upload into it. Treat a bare "/"
    # as the user's own root instead, which is what people mean.
    if p in ("", "/", "."):
        return ROOT
    return p if p.startswith("/") else f"{ROOT}/{p}"


def run(*args, capture=False, attempts=3):
    # Transient failures happen: a single list call can come back "You need to
    # login first" while the session is perfectly valid (the CLI reloads and
    # refreshes the session on every invocation). Without a retry, one blip
    # aborts a whole verify run and looks like being logged out.
    import time
    delay = 2.0
    for n in range(attempts):
        r = subprocess.run([CLI, *args], capture_output=capture, text=True)
        if r.returncode == 0:
            return r.stdout if capture else None
        if not capture:
            sys.exit(r.returncode)
        msg = ((r.stderr or "") + (r.stdout or "")).strip()
        if n == attempts - 1:
            sys.stderr.write(msg + "\n")
            sys.exit(f"pd: '{' '.join(args)}' failed after {attempts} attempts")
        print(f"  retrying after: {msg.splitlines()[0][:80] if msg else 'error'}",
              file=sys.stderr)
        time.sleep(delay)
        delay *= 2


def verify_path(local, remote, deep=False, fix=False):
    """Compare a local path against Proton; return 0 if everything matches.

    fix=True re-uploads anything missing or corrupt, then re-checks.
    """
    import hashlib
    import json
    import tempfile

    local = os.path.abspath(local.rstrip("/"))
    if not os.path.exists(local):
        sys.exit(f"pd verify: no such local path: {local}")

    def sha1_file(p):
        h = hashlib.sha1()
        with open(p, "rb") as f:
            while chunk := f.read(1 << 20):
                h.update(chunk)
        return h.hexdigest()

    # Collect the remote tree: one list call per folder (no recursion flag).
    remote_files = {}

    def crawl(rpath, prefix=""):
        data = json.loads(run("filesystem", "list", rpath, "--json",
                              capture=True) or "[]")
        for e in data:
            nm = e.get("name") or {}
            if not nm.get("ok"):
                print(f"  ?? undecryptable name under {prefix or '/'}")
                continue
            name = nm["value"]
            # Keep the true name AND the on-disk name the CLI would write,
            # so this works whether you are checking an upload (names match)
            # or a mirrored/downloaded copy (names were sanitised).
            rel = f"{prefix}/{name}".lstrip("/")
            esc = name.replace("\\", "\\\\").replace("/", "\\/")
            if e.get("type") == "folder":
                crawl(f"{rpath}/{esc}", rel)
            else:
                rev = e.get("activeRevision") or {}
                remote_files[rel] = {
                    "size": rev.get("claimedSize"),
                    "sha1": ((rev.get("claimedDigests") or {})
                             .get("sha1") or "").lower(),
                    "path": f"{rpath}/{esc}",
                }

    if os.path.isdir(local):
        local_files = {}
        for dp, _dn, fn in os.walk(local):
            for f in fn:
                full = os.path.join(dp, f)
                local_files[os.path.relpath(full, local)] = full
        crawl(remote)
    else:
        local_files = {os.path.basename(local): local}
        parent = remote.rsplit("/", 1)[0] or ROOT
        crawl(parent)
        remote_files = {k: v for k, v in remote_files.items()
                        if k == os.path.basename(local)}

    # The CLI rewrites [\x00-\x1f\x7f<>:"|?*\\/] to _ when writing to disk,
    # so a mirrored copy of "a:b.txt" is on disk as "a_b.txt". Index remote
    # entries under both names; exact match wins.
    unsafe = re.compile(r'[\x00-\x1f\x7f<>:"|?*\\/]')
    for rel in list(remote_files):
        alt = "/".join(unsafe.sub("_", part) for part in rel.split("/"))
        if alt != rel and alt not in remote_files:
            remote_files[alt] = remote_files[rel]

    ok = missing = mismatch = 0
    problems = []          # (rel, local path, needs_replace)
    for rel in sorted(local_files):
        lp = local_files[rel]
        r = remote_files.get(rel)
        if r is None:
            print(f"  MISSING   {rel}")
            problems.append((rel, lp, False))
            missing += 1
            continue
        lsize = os.path.getsize(lp)
        if r["size"] is not None and r["size"] != lsize:
            print(f"  SIZE      {rel}  local={lsize} remote={r['size']}")
            problems.append((rel, lp, True))
            mismatch += 1
            continue
        lsha = sha1_file(lp)
        if r["sha1"] and r["sha1"] != lsha:
            print(f"  SHA1      {rel}")
            problems.append((rel, lp, True))
            mismatch += 1
            continue
        if not r["sha1"]:
            print(f"  NO-DIGEST {rel} (size matches; cannot verify content)")
            mismatch += 1
            continue
        if deep:
            # The stored sha1 is claimed by whichever client uploaded the
            # file; Proton does not recompute it. Downloading and re-hashing
            # is the only check that proves a real round trip.
            with tempfile.TemporaryDirectory() as td:
                run("filesystem", "download", "-f", "replace",
                    r["path"], local_arg(td), capture=True)
                got = os.path.join(td, os.path.basename(rel))
                if not os.path.exists(got) or sha1_file(got) != lsha:
                    print(f"  ROUNDTRIP {rel}")
                    problems.append((rel, lp, True))
                    mismatch += 1
                    continue
        ok += 1

    # Aliases were injected above, so report EXTRA on true names only.
    extra = sorted(k for k in set(remote_files) - set(local_files)
                   if not any(remote_files.get(o) is remote_files[k]
                              and o in local_files
                              for o in remote_files))
    for rel in extra:
        print(f"  EXTRA     {rel} (in Proton, not local)")

    if fix and problems:
        replacing = [p for p in problems if p[2]]
        if replacing:
            print(f"\nWARNING: {len(replacing)} file(s) differ from Proton and "
                  f"will be OVERWRITTEN with the local copy.")
            print("         If you edited them in Proton (web UI or another "
                  "client), that version is lost.")
            print("         Files that exist only in Proton are never touched.")
        print(f"\nfixing {len(problems)} file(s)...")
        made = set()
        for rel, lp, needs_replace in problems:
            sub = os.path.dirname(rel)
            parent = remote
            # Recreate any missing intermediate folders, one level at a time.
            for part in [p for p in sub.split(os.sep) if p]:
                if (parent, part) not in made:
                    subprocess.run([CLI, "filesystem", "create-folder",
                                    parent, part],
                                   capture_output=True, text=True)
                    made.add((parent, part))
                parent = f"{parent}/" + part.replace("\\", "\\\\").replace("/", "\\/")
            # replace, not skip: skip only checks existence, so a corrupt or
            # short file would be left exactly as it is.
            # -t here on purpose: thumbnail generation is the single biggest
            # cause of upload failures (TIFF needs an OS codec; anything whose
            # extension lies about its content is rejected outright). The first
            # pass tries for thumbnails; the repair pass prioritises getting the
            # bytes there.
            strat = "replace" if needs_replace else "skip"
            r2 = subprocess.run([CLI, "filesystem", "upload", "-t", "-f", strat,
                                 local_arg(lp), parent], capture_output=True, text=True)
            state = "ok" if r2.returncode == 0 else f"FAILED rc={r2.returncode}"
            print(f"  {strat:7} {rel}  {state}")
        print("\nre-checking...")
        return verify_path(local, remote, deep=deep, fix=False)

    mode = "deep" if deep else "sha1"
    print(f"\n{ok}/{len(local_files)} verified ({mode}), "
          f"{missing} missing, {mismatch} mismatched, {len(extra)} extra")
    if not deep and ok == len(local_files) and not missing and not mismatch:
        print("note: sha1 is the digest the uploading client claimed; "
              "Proton does not recompute it. Use --deep to prove a round trip.")
    return 1 if (missing or mismatch) else 0



def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(USAGE)
        return 0
    cmd, rest = argv[0], argv[1:]

    def need(n, what):
        if len(rest) < n:
            sys.exit(f"pd {cmd}: need {what}")

    if cmd == "ls":
        run("filesystem", "list", abs_remote(rest[0]) if rest else ROOT)

    elif cmd == "info":
        need(1, "a path")
        run("filesystem", "info", abs_remote(rest[0]))

    elif cmd == "find":
        need(1, "a search string")
        import json
        q = rest[0].lower()
        where = abs_remote(rest[1]) if len(rest) > 1 else ROOT
        data = json.loads(run("filesystem", "list", where, "--json",
                              capture=True) or "[]")
        hits = 0
        for e in data:
            name = (e.get("name") or {}).get("value") or ""
            if q in name.lower():
                size = (e.get("activeRevision") or {}).get("claimedSize")
                sz = f"{size/1e6:.1f} MB" if size else ""
                print(f"{e.get('type','?'):7} {name}  {sz}")
                hits += 1
        print(f"-- {hits} match(es) in {where}", file=sys.stderr)

    elif cmd == "add":
        need(1, "local files")
        no_verify = "--no-verify" in rest
        # Thumbnails are off by default. They are generated for anything that
        # looks like an image and REJECT THE WHOLE FILE when they fail, which
        # they do for TIFF/HEIC/AVIF and for any file whose extension lies about
        # its content. Opting in costs upload time and gains previews in
        # Proton's apps; opting out just works.
        want_thumbs = "--thumbs" in rest
        rest = [a for a in rest
                if a not in ("--no-verify", "--thumbs", "--no-thumbs")]
        # If the last argument exists locally it is a source, not a destination.
        if os.path.exists(rest[-1]) or len(rest) == 1:
            srcs, dest = rest, ROOT
        else:
            srcs, dest = rest[:-1], abs_remote(rest[-1])
        missing = [s for s in srcs if not os.path.exists(s)]
        if missing:
            sys.exit("pd add: no such local path: " + ", ".join(missing))
        print(f"uploading {len(srcs)} item(s) -> {dest}"
              + (" (with thumbnails)" if want_thumbs else ""))
        # -d merge, NOT -c skip. With skip applied to folders, re-adding a
        # directory that already exists skips the ENTIRE folder and uploads
        # nothing inside it. merge descends into it; skip then applies to the
        # files, leaving identical ones alone.
        cmd_args = [CLI, "filesystem", "upload", "-d", "merge", "-f", "skip"]
        if not want_thumbs:
            cmd_args.append("-t")
        r = subprocess.run([*cmd_args, *[local_arg(x) for x in srcs], dest])
        if no_verify:
            return r.returncode

        # Upload alone proves nothing: -f skip skips on existence rather than
        # content, so re-running after a bad upload leaves the damage in place,
        # and the CLI has been seen exiting 0 on a failed transfer. Check every
        # file and repair what is wrong, so a repeated `pd add` converges.
        print("\nverifying...")
        worst = r.returncode
        for src in srcs:
            base = os.path.basename(os.path.abspath(src.rstrip("/")))
            rc = verify_path(os.path.abspath(src.rstrip("/")),
                             f"{dest}/{base}", fix=True)
            worst = max(worst, rc)
        return worst

    elif cmd == "mkdir":
        need(1, "a folder name")
        # One arg: create in /my-files. Two args: <parent> <name>.
        if len(rest) == 1:
            parent, name = ROOT, rest[0]
        else:
            parent, name = abs_remote(rest[0]), rest[1]
        run("filesystem", "create-folder", parent, name)

    elif cmd == "get":
        need(1, "a remote path")
        # Trailing local dir only counts if it is not itself a remote-looking arg.
        if len(rest) > 1 and os.path.isdir(rest[-1]):
            paths, dest = rest[:-1], rest[-1]
        else:
            paths, dest = rest, "."
        run("filesystem", "download", "-f", "skip",
            *[abs_remote(p) for p in paths], local_arg(dest))

    elif cmd in ("mv", "cp"):
        need(2, "one or more sources and a destination folder")
        sub = "move" if cmd == "mv" else "copy"
        srcs = [abs_remote(p) for p in rest[:-1]]
        run("filesystem", sub, *srcs, abs_remote(rest[-1]))

    elif cmd == "rn":
        need(2, "a path and a new name")
        run("filesystem", "rename", abs_remote(rest[0]), rest[1])

    elif cmd == "rm":
        need(1, "a path")
        run("filesystem", "trash", *[abs_remote(p) for p in rest])
        print("moved to Proton trash - 'pd restore <path>' undoes this")

    elif cmd == "restore":
        need(1, "a path")
        run("filesystem", "restore", *[abs_remote(p) for p in rest])

    elif cmd == "purge":
        need(1, "a path")
        print("PERMANENT delete, not recoverable:")
        for p in rest:
            print("  " + abs_remote(p))
        if input("type DELETE to confirm: ") != "DELETE":
            sys.exit("aborted")
        run("filesystem", "delete", *[abs_remote(p) for p in rest])

    elif cmd == "verify":
        deep = "--deep" in rest
        fix = "--fix" in rest
        rest = [a for a in rest if a not in ("--deep", "--fix")]
        need(1, "a local path")
        loc = os.path.abspath(rest[0].rstrip("/"))
        rem = (abs_remote(rest[1]) if len(rest) > 1
               else f"{ROOT}/{os.path.basename(loc)}")
        return verify_path(loc, rem, deep=deep, fix=fix)

    elif cmd == "prune-thumbs":
        import hashlib
        import json
        import tempfile

        dry = "--dry-run" in rest
        yes = "--yes" in rest
        rest = [a for a in rest if a not in ("--dry-run", "--yes")]
        remote = abs_remote(rest[0]) if rest else ROOT
        # A verified local copy avoids downloading everything again. The NAS
        # mirror is ideal: same bytes, already sha1-checked by the sync.
        local_root = None
        for i, a in enumerate(rest):
            if a == "--local-root" and i + 1 < len(rest):
                local_root = rest[i + 1]
        if local_root is None and remote.startswith(ROOT):
            guess = "/media/proton/my-files" + remote[len(ROOT):]
            if os.path.isdir(guess):
                local_root = guess

        unsafe = re.compile(r'[\x00-\x1f\x7f<>:"|?*\\/]')

        def on_disk(name):
            z = unsafe.sub("_", name)
            return {"": "_", ".": "_", "..": "__"}.get(z, z)

        def sha1_file(p):
            h = hashlib.sha1()
            with open(p, "rb") as f:
                while chunk := f.read(1 << 20):
                    h.update(chunk)
            return h.hexdigest()

        # Thumbnails are counted in the revision's storageSize, so the gap
        # between that and claimedSize (the plaintext size) reveals them.
        # Encryption alone costs well under 500 bytes.
        THRESHOLD = 500
        found = []

        def crawl(rpath, prefix=""):
            data = json.loads(run("filesystem", "list", rpath, "--json",
                                  capture=True) or "[]")
            for e in data:
                nm = e.get("name") or {}
                if not nm.get("ok"):
                    continue
                name = nm["value"]
                esc = name.replace("\\", "\\\\").replace("/", "\\/")
                rel = f"{prefix}/{on_disk(name)}".lstrip("/")
                if e.get("type") == "folder":
                    crawl(f"{rpath}/{esc}", rel)
                    continue
                r = e.get("activeRevision") or {}
                s, c = r.get("storageSize"), r.get("claimedSize")
                if s is None or c is None or (s - c) <= THRESHOLD:
                    continue
                found.append({
                    "rel": rel, "name": name, "parent": rpath,
                    "path": f"{rpath}/{esc}", "over": s - c,
                    "size": c,
                    "sha1": ((r.get("claimedDigests") or {})
                             .get("sha1") or "").lower(),
                })

        print(f"scanning {remote} ...")
        crawl(remote)
        if not found:
            print("no thumbnails found")
            return 0
        tot = sum(f["over"] for f in found)
        bytes_up = sum(f["size"] for f in found)
        print(f"\n{len(found)} file(s) carry ~{tot/1024:.0f} KiB of thumbnail data")
        print(f"stripping them means re-uploading {bytes_up/1e9:.2f} GB")
        print(f"local source: {local_root or '(none - will download each file)'}")
        if dry:
            for f in found[:20]:
                print(f"  {f['rel']}  (+{f['over']} B)")
            if len(found) > 20:
                print(f"  ... and {len(found)-20} more")
            return 0
        print("\nEach file is TRASHED and re-uploaded without a thumbnail.")
        print("Share links and revision history for these files are lost.")
        if not yes and input("type PRUNE to proceed: ") != "PRUNE":
            sys.exit("aborted")

        done = skipped = failed = 0
        for n, f in enumerate(found, 1):
            src = os.path.join(local_root, f["rel"]) if local_root else None
            tmp = None
            if not (src and os.path.exists(src)):
                # No local copy: fetch it, so we never delete something we
                # cannot put back.
                tmp = tempfile.mkdtemp()
                run("filesystem", "download", "-f", "replace", f["path"],
                    local_arg(tmp), capture=True)
                cand = os.path.join(tmp, on_disk(f["name"]))
                src = cand if os.path.exists(cand) else None
            # Refuse to touch anything we cannot reproduce byte-for-byte.
            if not src or (f["sha1"] and sha1_file(src) != f["sha1"]):
                print(f"  [{n}/{len(found)}] SKIP {f['rel']} "
                      f"(no verified local copy)")
                skipped += 1
                if tmp:
                    subprocess.run(["rm", "-rf", tmp])
                continue
            subprocess.run([CLI, "filesystem", "trash", f["path"]],
                           capture_output=True, text=True)
            up = subprocess.run([CLI, "filesystem", "upload", "-t",
                                 "-d", "merge", "-f", "replace",
                                 local_arg(src), f["parent"]],
                                capture_output=True, text=True)
            if up.returncode == 0:
                print(f"  [{n}/{len(found)}] ok   {f['rel']}")
                done += 1
            else:
                print(f"  [{n}/{len(found)}] FAIL {f['rel']}: "
                      f"{(up.stderr or up.stdout or '').strip()[:120]}")
                print(f"       the original is in /trash - restore it with: "
                      f"pd restore /trash/{f['name']}")
                failed += 1
            if tmp:
                subprocess.run(["rm", "-rf", tmp])

        print(f"\npruned {done}, skipped {skipped}, failed {failed}")
        print("originals are in Proton's trash; empty it to reclaim the space")
        return 1 if failed else 0

    elif cmd == "share":
        need(1, "a path")
        run("sharing", "status", abs_remote(rest[0]))

    elif cmd == "raw":
        run(*rest)

    else:
        sys.exit(f"pd: unknown command {cmd!r}\n\n{USAGE}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
